# =============================================================================
# ChaseHorse Deploy - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your own values.
# Never commit real credentials to source control.
# =============================================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ChaseHorse Deploy
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Example: postgresql://user:password@localhost:5432/chasehorse_deploy?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chasehorse_deploy?schema=public"

# --- Authentication (Auth.js / NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL=http://localhost:3000

# --- Goods tracking (optional) ---
# Enable Google Maps Embed API and restrict the browser key to your site origin.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- AI Provider Configuration ---
# Primary provider: gemini (default). Supported: gemini, openai, anthropic.
AI_PROVIDER=gemini

# Google Gemini API key (obtain from https://aistudio.google.com)
# Leave empty to run without AI. The assistant will show a setup message.
GEMINI_API_KEY=""

# Default Gemini model. Select based on current availability, cost, and latency.
# Do not assume a particular model name or free tier will remain available.
GEMINI_MODEL="gemini-1.5-flash-latest"

# OpenAI API key (optional - only configure if you intend to use OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic API key (optional - only configure if you intend to use Anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-haiku-20240307"

# AI safety / spending limits
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"
# Optional: maximum estimated USD spend per day (provider-dependent, where supported)
AI_DAILY_SPEND_LIMIT_USD=""

# --- Document Storage ---
# For local development, files are stored under ./storage/uploads
# For production, set STORAGE_PROVIDER=s3 and provide S3 credentials below.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH="./storage/uploads"

# S3-compatible storage (optional, for production)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Security ---
# Maximum upload size in bytes (default 10 MB)
MAX_UPLOAD_SIZE_BYTES="10485760"

# --- Feature Flags ---
DEMO_MODE="false"
